# --- Postgres ---
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_NAME=warehouse_db

# Used only when running a service directly on the host (go run / *.exe),
# outside of docker-compose. Inside docker-compose this is built
# automatically from the three variables above and points at the
# "postgres" service instead of localhost.
DATABASE_URL=postgres://user:password@localhost:5433/warehouse_db?sslmode=disable

# --- Auth ---
# Shared HMAC secret used to sign/validate JWTs. Must be the SAME value
# for the auth and order services (order validates tokens locally).
JWT_SECRET=supersecret

# --- Kafka / gRPC ---
# These defaults are only used for running services on the host.
# docker-compose overrides them with the in-network service names
# (kafka:9092, warehouse:50051).
KAFKA_BROKERS=localhost:29092
WAREHOUSE_GRPC_ADDR=localhost:50051
